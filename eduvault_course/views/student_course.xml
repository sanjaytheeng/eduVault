<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="course_student_form_view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="inherit_id" ref="eduvault_core.view_op_student_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook" position="inside">
                    <page name="course_details" string="Course Detail">
                        <list>
                            <field name="course_detail_ids"/>
                        </list>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_op_student_search_inherit" model="ir.ui.view">
            <field name="name">op.student.search.inherit</field>
            <field name="model">op.student</field>
            <field name="inherit_id" ref="eduvault_core.view_op_student_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search/group" position="inside">
                    <filter string="Courses" name="group_by_course" domain="[]" context="{'group_by':'course_id'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>