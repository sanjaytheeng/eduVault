<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Alumni List View -->
        <record id="view_alumni_list" model="ir.ui.view">
            <field name="name">alumni.list</field>
            <field name="model">alumni.alumni</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Alumni List">
                    <field name="first_name"/>
                    <field name="middle_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="mobile"/>
                    <field name="company"/>
                    <field name="position"/>
                    <field name="graduation_date"/>
                </list>
            </field>
        </record>

        <!-- Alumni Form View -->
        <record id="view_alumni_form" model="ir.ui.view">
            <field name="name">alumni.form</field>
            <field name="model">alumni.alumni</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Alumni Record">
                    <header/>
                    <sheet>
                        <group>
                            <group>
                                <field name="first_name"/>
                                <field name="middle_name"/>
                                <field name="last_name"/>
                                <field name="email"/>
                                <field name="mobile"/>
                                <field name="address"/>
                            </group>
                            <group>
                                <field name="batch_id"/>
                                <field name="course_id"/>
                                <field name="graduation_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Professional Details">
                                <group>
                                    <field name="company"/>
                                    <field name="position"/>
                                    <field name="industry"/>
                                    <field name="experience"/>
                                </group>
                            </page>
                            <page string="Involvement">
                                <group>
                                    <field name="mentorship"/>
                                    <field name="event_participation"/>
                                    <field name="donation_contributor"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Alumni Search View -->
        <record id="view_alumni_search" model="ir.ui.view">
            <field name="name">alumni.search</field>
            <field name="model">alumni.alumni</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Alumni Search">
                    <field name="first_name"/>
                    <field name="middle_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="company"/>
                    <field name="batch_id"/>
                    <field name="graduation_date"/>
                </search>
            </field>
        </record>

        <!-- Alumni Action -->
        <record id="act_open_alumni_view" model="ir.actions.act_window">
            <field name="name">Alumni</field>
            <field name="res_model">alumni.alumni</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new alumni record.
                </p>
            </field>
            <field name="search_view_id" ref="view_alumni_search"/>
        </record>

        <!-- Alumni Action Views -->
        <record id="act_open_alumni_view_list" model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_alumni_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_alumni_list"/>
        </record>

        <record id="act_open_alumni_view_form" model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_alumni_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_alumni_form"/>
        </record>

    </data>
</odoo>
