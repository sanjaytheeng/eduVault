<odoo>
    <record id="view_student_fees_details_list" model="ir.ui.view">
        <field name="name">op.student.fees.details.list</field>
        <field name="model">op.student.fees.details</field>
        <field name="arch" type="xml">
            <list string="Student Fees Details">
                <field name="student_id"/>
                <field name="fees_line_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="invoice_id"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="discount"/>
                <field name="after_discount_amount"/>
                <field name="course_id"/>
                <field name="batch_id"/>
            </list>
        </field>
    </record>

    <record id="action_student_fees_details" model="ir.actions.act_window">
        <field name="name">Student Fees Details</field>
        <field name="res_model">op.student.fees.details</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_student_fees_details_list"/>
        <field name="target">current</field>
    </record>
</odoo>
